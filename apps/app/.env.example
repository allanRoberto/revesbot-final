# URL do Express (auth_api / bot_automatico) que valida o login na LotoGreen.
# Produção: https://auth.revesbot.com.br | Local: http://localhost:3090
EXPRESS_URL=https://auth.revesbot.com.br

# Porta e estágio do servidor Next.js.
APP_HOST=127.0.0.1
APP_PORT=3002
DEPLOY_STAGE=main

# MongoDB
MONGO_URL=mongodb://usuario:senha@host:porta/roleta_db?authSource=admin
MONGO_DB=roleta_db

# Segredo para assinar o cookie de sessão (JWT).
JWT_SECRET=troque-por-um-segredo-forte

# Chave AES-256 (base64, 32 bytes) para criptografar a senha quando autoReconnect=true.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# PIX (manual). Chave que recebe os pagamentos + dados do recebedor (BR Code).
PIX_KEY=
PIX_MERCHANT_NAME=REVESBOT
PIX_MERCHANT_CITY=SAO PAULO

# Serviço bet_ws (captura o WS da mesa e envia as apostas). Server-to-server.
BET_WS_URL=http://127.0.0.1:4060
BET_WS_TOKEN=

# Automação: token deve ser igual no Next.js e no bet_ws.
AUTOMATION_INTERNAL_TOKEN=
# Meta inicial em basis points sobre a banca (1000 = 10%).
AUTO_TARGET_RATE_BPS=1000
# Limite de perda em basis points sobre a banca (2000 = 20%).
AUTO_MAX_LOSS_RATE_BPS=2000

# PixGo API v1 (somente servidor).
PIXGO_API_KEY=
PIXGO_WEBHOOK_SECRET=
PIXGO_WEBHOOK_URL=https://seu-dominio.com/api/webhooks/pixgo
PIXGO_BASE_URL=https://pixgo.org/api/v1

# Servidor de mídia (HLS das mesas). Público em prod; em dev via túnel SSH.
NEXT_PUBLIC_VIDEO_BASE=http://localhost:8099

# house-agent (login headless p/ casas Nuxt/BFF: Esportiva, Bateu).
HOUSE_AGENT_URL=http://127.0.0.1:4080
HOUSE_AGENT_TOKEN=

# Recursos opcionais/controlados por ambiente.
SUBSCRIPTION_ENABLED=false
AUTOMATION_SIGNAL_SOURCE_ENABLED=false
ORBIT_API_URL=http://127.0.0.1:8080
