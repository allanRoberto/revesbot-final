# Porta do serviço bet_ws
BET_WS_PORT=4060
BET_WS_HOST=127.0.0.1
NODE_ENV=production

# Valor padrão de ficha por número (usado quando o app não manda chipValue)
BASE_CHIP=0.5

# Token compartilhado app <-> serviço (server-to-server). Deixe vazio p/ desabilitar em dev.
BET_WS_TOKEN=

# Mesmo token configurado em apps/app. Protege sugestão e callbacks internos.
AUTOMATION_INTERNAL_TOKEN=

# URL privada do Next.js vista pelo bet_ws.
AUTOMATION_APP_URL=http://127.0.0.1:3002

# TTL de sessão inativa (ms). Default 30 min.
SESSION_IDLE_TTL_MS=1800000
