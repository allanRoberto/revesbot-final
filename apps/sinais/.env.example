# Variáveis do app de sinais (lidas do .env na raiz do repo).
# Stripe e Mongo já existem no .env principal; aqui documentamos tudo que o app usa.

# Banco (mesmo cluster da API; history é só-leitura)
MONGO_URL=mongodb://user:pass@127.0.0.1:27018/roleta_db?authSource=admin

# Servidor / URL pública
SINAIS_PORT=8090
SINAIS_APP_URL=https://sinais.revesbot.com.br

# Clerk (login)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
# Opcionais
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=

# Stripe (compra de créditos)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Regras de produto (opcionais — têm default no código)
# SINAIS_ROULETTE_IDS=pragmatic-brazilian-roulette,pragmatic-auto-roulette,pragmatic-immersive-roulette-deluxe
# SIGNUP_CREDITS=5
# HISTORY_WINDOW=300
# ATTEMPTS=3
# ENTRY_NUMBERS=12
# SETTLEMENT_POLL_SECONDS=2
